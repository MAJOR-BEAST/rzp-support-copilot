# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → app → Settings → Secrets.
# Never commit the real secrets.toml (it is in .gitignore).

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
PINECONE_API_KEY = "pcsk_your-key-here"
APP_PASSWORD = "choose-a-password"

# Optional (these defaults are used if omitted)
MODEL_FAST = "claude-haiku-5-5"
MODEL_DRAFT = "claude-sonnet-5-5"
VECTOR_BACKEND = "pinecone"   # or "local" (TF-IDF, no Pinecone needed)
