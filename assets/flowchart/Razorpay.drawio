        <mxCell id="n14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=12;" value="&lt;b&gt;9 · Two requests in one message?&lt;/b&gt;&lt;br&gt;the riskier one decides" vertex="1">
