        <mxCell id="n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=12;" value="&lt;b&gt;7 · Open the merchant&#39;s file&lt;/b&gt;&lt;br&gt;payout status · hold reason · expected date · success rate · disputes · refunds · KYC&lt;br&gt;+ is this their 4th+ ticket? (repeat contact)" vertex="1">
          <mxGeometry height="100" width="280" x="60" y="835" as="geometry" />
