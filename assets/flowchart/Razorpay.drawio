        <mxCell id="n1" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;Razorpay Merchant Support Copilot — how every ticket is handled (v2, decisions locked)&lt;/font&gt;" vertex="1">
          <mxGeometry height="44" width="1600" x="570" y="-20" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0BEC5;verticalAlign=top;align=center;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" value="STAGE 1 · Read the ticket and run safety checks" vertex="1">
          <mxGeometry height="1430" width="760" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1F3A93;fontColor=#FFFFFF;strokeColor=#1F3A93;fontStyle=1;fontSize=12;" value="&lt;b&gt;1 · A ticket arrives&lt;/b&gt;&lt;br&gt;150 tickets via Email, Chat, WhatsApp" vertex="1">
          <mxGeometry height="60" width="280" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=12;" value="&lt;b&gt;2 · Pick out the key details&lt;/b&gt;&lt;br&gt;merchant ID · payment ID · ₹ amount · &quot;how many days&quot; · English or Hinglish" vertex="1">
          <mxGeometry height="75" width="280" x="60" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;" value="&lt;b&gt;3 · Is it a threat?&lt;/b&gt;&lt;br&gt;legal, police, RBI, media, data leak, bribe, hacked account, &quot;fraud&quot;" vertex="1">
          <mxGeometry height="130" width="190" x="105" y="305" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B71C1C;fontSize=11;" value="&lt;b&gt;ESCALATE · CRITICAL&lt;/b&gt;&lt;br&gt;Legal / Security / Compliance&lt;br&gt;Reply only: &quot;received, specialist team will contact you&quot;. No apology admitting fault, no promise.&lt;br&gt;&lt;i&gt;→ goes to Step 10&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="400" y="315" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;" value="&lt;b&gt;4 · Merchant ID missing?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="190" x="105" y="465" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;fontSize=11;" value="&lt;b&gt;ASK&lt;/b&gt; for merchant ID&lt;br&gt;(and payment ID if it is about a refund or a specific payment) — 6 tickets&lt;br&gt;&lt;i&gt;→ goes to Step 10&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="400" y="470" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3A93;strokeWidth=2;fontSize=12;" value="&lt;b&gt;5 · AI reads the message&lt;/b&gt;&lt;br&gt;topic (1 of 10) · mood (calm / frustrated / angry) · how sure it is (0–100%)" vertex="1">
          <mxGeometry height="80" width="280" x="60" y="595" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;" value="&lt;b&gt;6 · AI less than 80% sure?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="190" x="105" y="705" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;fontSize=11;" value="&lt;b&gt;ASK&lt;/b&gt; one clear question that uses what we know&lt;br&gt;e.g. &quot;your payouts are on hold — is this about that?&quot;&lt;br&gt;&lt;i&gt;→ goes to Step 10&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="400" y="710" as="geometry" />
